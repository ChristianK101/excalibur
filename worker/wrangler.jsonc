{
  // Deployed from this repo by Cloudflare Workers Builds.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "excalibur-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-05-21",
  "observability": {
    "enabled": true
  },
  "vars": {
    // Origins permitted to call this worker. Add http://localhost:8899 while testing.
    "ALLOWED_ORIGINS": "https://excaliburloungesd.com,https://www.excaliburloungesd.com",

    // Clover merchant for the Clairemont Mesa lounge. This is an identifier,
    // not a credential; the API token is a dashboard secret (CLOVER_TOKEN).
    // The account also holds Excalibur Lounge RB and Las Villas Cigars, so
    // this pins reporting to the one location.
    "CLOVER_MERCHANT_ID": "0THXDWP2MC91Y",

    // Sender for password reset emails. The domain must be verified with
    // Resend or the mail is refused. RESEND_API_KEY is a dashboard secret.
    "RESET_FROM": "Excalibur Lounge <no-reply@excaliburloungesd.com>"
    // OWNER_EMAIL is set as a secret, not here — see README.md
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excalibur-accounts",
      "database_id": "40536dc9-3e13-4e92-aa00-8143a73c3267"
    }
  ]
}
